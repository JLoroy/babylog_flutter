pluginManagement {
    repositories {
        google()
        mavenCentral()
        gradlePluginPortal()
        maven {
            url "D:/flutter//packages/flutter_tools/gradle"
        }
    }
}

include ':app'

// Configure repositories for all projects
dependencyResolutionManagement {
    repositoriesMode.set(RepositoriesMode.PREFER_SETTINGS)
    repositories {
        google()
        mavenCentral()
        maven {
            url "D:/flutter//bin/cache/artifacts/engine/android-gradle-plugin"
        }
    }
}